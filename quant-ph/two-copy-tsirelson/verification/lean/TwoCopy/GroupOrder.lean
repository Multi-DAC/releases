/-
Two-copy identity: the order of H (the "if cheap" item of target (a)). Nothing in the other
files depends on this one; Theorem 1 does not use it.

What this file proves, in plain words.

  * `mem_H_iff_word`: a permutation of Ω lies in H (the group generated by the four τ_j) iff it
    acts as one of the 64 words (τ₀τ₁)^i τ₀^a (τ₂τ₃)^i′ τ₂^a′ with i, i′ ∈ {0, 1, 2, 3} and
    a, a′ ∈ {0, 1} (`wfun`); the 64 words are pairwise different (`wfun_zero_injective`: they
    take 64 different values at the all-zero point).
  * `card_H`: H has order 64.

How. A generator of copy 1 times a copy-1 word (τ₀τ₁)^i τ₀^a is again such a word (`genA0`,
`genA1`, closed computations on the 256 points), likewise for copy 2 (`genB2`, `genB3`), and the
generators of copy 2 commute with those of copy 1 (`comm_tau`); so the 64 words are closed under
multiplication on the left by each generator, hence contain the group generated. Each word is a
product of generators, so it lies in H.

Not proved: that H is the product of two dihedral groups of order 8 (only the normal form that
this would give), and that each image of S arises from exactly 16 elements of H.
-/
import TwoCopy.Images

namespace TwoCopy

open Finset

/-- The index of a word: (i, a, i′, a′). -/
abbrev Word := Fin 4 × Fin 2 × Fin 4 × Fin 2

/-- (τ₀τ₁)^i. -/
def rotA (i : Fin 4) (ω : Pt) : Pt :=
  if i = 0 then ω else if i = 1 then tau 0 (tau 1 ω)
  else if i = 2 then tau 0 (tau 1 (tau 0 (tau 1 ω)))
  else tau 0 (tau 1 (tau 0 (tau 1 (tau 0 (tau 1 ω)))))

/-- τ₀^a. -/
def refA (a : Fin 2) (ω : Pt) : Pt := if a = 0 then ω else tau 0 ω

/-- (τ₂τ₃)^i. -/
def rotB (i : Fin 4) (ω : Pt) : Pt :=
  if i = 0 then ω else if i = 1 then tau 2 (tau 3 ω)
  else if i = 2 then tau 2 (tau 3 (tau 2 (tau 3 ω)))
  else tau 2 (tau 3 (tau 2 (tau 3 (tau 2 (tau 3 ω)))))

/-- τ₂^a. -/
def refB (a : Fin 2) (ω : Pt) : Pt := if a = 0 then ω else tau 2 ω

/-- The word (τ₀τ₁)^i τ₀^a (τ₂τ₃)^i′ τ₂^a′, as a map of Ω. -/
def wfun (p : Word) (ω : Pt) : Pt := rotA p.1 (refA p.2.1 (rotB p.2.2.1 (refB p.2.2.2 ω)))

/-! ### Closed computations -/

set_option maxRecDepth 100000 in
theorem genA0 : ∀ (i : Fin 4) (a : Fin 2), ∃ (i' : Fin 4) (a' : Fin 2), ∀ ω : Pt,
    tau 0 (rotA i (refA a ω)) = rotA i' (refA a' ω) := by decide +kernel

set_option maxRecDepth 100000 in
theorem genA1 : ∀ (i : Fin 4) (a : Fin 2), ∃ (i' : Fin 4) (a' : Fin 2), ∀ ω : Pt,
    tau 1 (rotA i (refA a ω)) = rotA i' (refA a' ω) := by decide +kernel

set_option maxRecDepth 100000 in
theorem genB2 : ∀ (i : Fin 4) (a : Fin 2), ∃ (i' : Fin 4) (a' : Fin 2), ∀ ω : Pt,
    tau 2 (rotB i (refB a ω)) = rotB i' (refB a' ω) := by decide +kernel

set_option maxRecDepth 100000 in
theorem genB3 : ∀ (i : Fin 4) (a : Fin 2), ∃ (i' : Fin 4) (a' : Fin 2), ∀ ω : Pt,
    tau 3 (rotB i (refB a ω)) = rotB i' (refB a' ω) := by decide +kernel

set_option maxRecDepth 100000 in
/-- The generators of copy 2 commute with those of copy 1. -/
theorem comm_tau : ∀ ω : Pt,
    tau 2 (tau 0 ω) = tau 0 (tau 2 ω) ∧ tau 2 (tau 1 ω) = tau 1 (tau 2 ω) ∧
      tau 3 (tau 0 ω) = tau 0 (tau 3 ω) ∧ tau 3 (tau 1 ω) = tau 1 (tau 3 ω) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The 64 words take 64 different values at the all-zero point. -/
theorem wfun_zero_injective : ∀ p p' : Word, wfun p 0 = wfun p' 0 → p = p' := by
  decide +kernel

/-! ### The words are closed under the generators -/

theorem comm2 (i : Fin 4) (a : Fin 2) (X : Pt) :
    tau 2 (rotA i (refA a X)) = rotA i (refA a (tau 2 X)) := by
  have c0 : ∀ ω, tau 2 (tau 0 ω) = tau 0 (tau 2 ω) := fun ω => (comm_tau ω).1
  have c1 : ∀ ω, tau 2 (tau 1 ω) = tau 1 (tau 2 ω) := fun ω => (comm_tau ω).2.1
  simp only [rotA, refA, apply_ite (tau 2), c0, c1]

theorem comm3 (i : Fin 4) (a : Fin 2) (X : Pt) :
    tau 3 (rotA i (refA a X)) = rotA i (refA a (tau 3 X)) := by
  have c0 : ∀ ω, tau 3 (tau 0 ω) = tau 0 (tau 3 ω) := fun ω => (comm_tau ω).2.2.1
  have c1 : ∀ ω, tau 3 (tau 1 ω) = tau 1 (tau 3 ω) := fun ω => (comm_tau ω).2.2.2
  simp only [rotA, refA, apply_ite (tau 3), c0, c1]

/-- A generator times a word is a word. -/
theorem gen_mul_word (j : Fin 4) (p : Word) : ∃ p' : Word, ∀ ω : Pt, tau j (wfun p ω) = wfun p' ω := by
  obtain ⟨i, a, i', a'⟩ := p
  fin_cases j
  · obtain ⟨i2, a2, h⟩ := genA0 i a
    exact ⟨(i2, a2, i', a'), fun ω => h _⟩
  · obtain ⟨i2, a2, h⟩ := genA1 i a
    exact ⟨(i2, a2, i', a'), fun ω => h _⟩
  · obtain ⟨i2, a2, h⟩ := genB2 i' a'
    refine ⟨(i, a, i2, a2), fun ω => ?_⟩
    show tau 2 (rotA i (refA a (rotB i' (refB a' ω)))) = rotA i (refA a (rotB i2 (refB a2 ω)))
    rw [comm2, h]
  · obtain ⟨i2, a2, h⟩ := genB3 i' a'
    refine ⟨(i, a, i2, a2), fun ω => ?_⟩
    show tau 3 (rotA i (refA a (rotB i' (refB a' ω)))) = rotA i (refA a (rotB i2 (refB a2 ω)))
    rw [comm3, h]

/-- Every element of H maps words to words by multiplication on the left. -/
theorem word_closed {g : Equiv.Perm Pt} (hg : g ∈ H) :
    ∀ p : Word, ∃ p' : Word, ∀ ω : Pt, g (wfun p ω) = wfun p' ω := by
  unfold H at hg
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    exact fun p => gen_mul_word j p
  | one => exact fun p => ⟨p, fun ω => rfl⟩
  | mul x y _ _ ihx ihy =>
    intro p
    obtain ⟨p1, h1⟩ := ihy p
    obtain ⟨p2, h2⟩ := ihx p1
    exact ⟨p2, fun ω => by rw [Equiv.Perm.mul_apply, h1, h2]⟩
  | inv x _ ih =>
    choose φ hφ using ih
    have hinj : Function.Injective φ := by
      intro p p' h
      apply wfun_zero_injective
      apply x.injective
      rw [hφ p 0, hφ p' 0, h]
    have hsurj : Function.Surjective φ := Finite.injective_iff_surjective.1 hinj
    intro p
    obtain ⟨q, rfl⟩ := hsurj p
    exact ⟨q, fun ω => by rw [← hφ q ω]; exact x.symm_apply_apply _⟩

/-! ### The words lie in H -/

theorem tauPerm_mem_H (j : Fin 4) : tauPerm j ∈ H := Subgroup.subset_closure ⟨j, rfl⟩

theorem exA (i : Fin 4) : ∃ g ∈ H, ∀ ω : Pt, g ω = rotA i ω := by
  have hr : tauPerm 0 * tauPerm 1 ∈ H := H.mul_mem (tauPerm_mem_H 0) (tauPerm_mem_H 1)
  fin_cases i
  · exact ⟨1, H.one_mem, fun ω => rfl⟩
  · exact ⟨tauPerm 0 * tauPerm 1, hr, fun ω => rfl⟩
  · exact ⟨tauPerm 0 * tauPerm 1 * (tauPerm 0 * tauPerm 1), H.mul_mem hr hr, fun ω => rfl⟩
  · exact ⟨tauPerm 0 * tauPerm 1 * (tauPerm 0 * tauPerm 1) * (tauPerm 0 * tauPerm 1),
      H.mul_mem (H.mul_mem hr hr) hr, fun ω => rfl⟩

theorem exB (i : Fin 4) : ∃ g ∈ H, ∀ ω : Pt, g ω = rotB i ω := by
  have hr : tauPerm 2 * tauPerm 3 ∈ H := H.mul_mem (tauPerm_mem_H 2) (tauPerm_mem_H 3)
  fin_cases i
  · exact ⟨1, H.one_mem, fun ω => rfl⟩
  · exact ⟨tauPerm 2 * tauPerm 3, hr, fun ω => rfl⟩
  · exact ⟨tauPerm 2 * tauPerm 3 * (tauPerm 2 * tauPerm 3), H.mul_mem hr hr, fun ω => rfl⟩
  · exact ⟨tauPerm 2 * tauPerm 3 * (tauPerm 2 * tauPerm 3) * (tauPerm 2 * tauPerm 3),
      H.mul_mem (H.mul_mem hr hr) hr, fun ω => rfl⟩

theorem exRefA (a : Fin 2) : ∃ g ∈ H, ∀ ω : Pt, g ω = refA a ω := by
  fin_cases a
  · exact ⟨1, H.one_mem, fun ω => rfl⟩
  · exact ⟨tauPerm 0, tauPerm_mem_H 0, fun ω => rfl⟩

theorem exRefB (a : Fin 2) : ∃ g ∈ H, ∀ ω : Pt, g ω = refB a ω := by
  fin_cases a
  · exact ⟨1, H.one_mem, fun ω => rfl⟩
  · exact ⟨tauPerm 2, tauPerm_mem_H 2, fun ω => rfl⟩

/-- Each word is the action of an element of H. -/
theorem wfun_mem_H (p : Word) : ∃ g ∈ H, ∀ ω : Pt, g ω = wfun p ω := by
  obtain ⟨i, a, i', a'⟩ := p
  obtain ⟨g1, h1, e1⟩ := exA i
  obtain ⟨g2, h2, e2⟩ := exRefA a
  obtain ⟨g3, h3, e3⟩ := exB i'
  obtain ⟨g4, h4, e4⟩ := exRefB a'
  refine ⟨g1 * g2 * g3 * g4, H.mul_mem (H.mul_mem (H.mul_mem h1 h2) h3) h4, fun ω => ?_⟩
  simp only [Equiv.Perm.mul_apply, e1, e2, e3, e4]
  rfl

/-! ### The order of H -/

/-- H is exactly the set of the 64 words. -/
theorem mem_H_iff_word (g : Equiv.Perm Pt) : g ∈ H ↔ ∃ p : Word, ∀ ω : Pt, g ω = wfun p ω := by
  constructor
  · intro hg
    obtain ⟨p', hp'⟩ := word_closed hg (0, 0, 0, 0)
    exact ⟨p', fun ω => hp' ω⟩
  · rintro ⟨p, hp⟩
    obtain ⟨g', hg', e⟩ := wfun_mem_H p
    have : g = g' := Equiv.ext fun ω => (hp ω).trans (e ω).symm
    rw [this]; exact hg'

/-- **H has order 64.** -/
theorem card_H : Nat.card H = 64 := by
  choose gp hgp egp using wfun_mem_H
  have hbij : Function.Bijective (fun p : Word => (⟨gp p, hgp p⟩ : H)) := by
    constructor
    · intro p p' h
      have h' : gp p = gp p' := congrArg Subtype.val h
      apply wfun_zero_injective
      rw [← egp p 0, ← egp p' 0, h']
    · rintro ⟨g, hg⟩
      obtain ⟨p, hp⟩ := (mem_H_iff_word g).1 hg
      exact ⟨p, Subtype.ext (Equiv.ext fun ω => (egp p ω).trans (hp ω).symm)⟩
  rw [← Nat.card_eq_of_bijective _ hbij, Nat.card_eq_fintype_card]
  simp [Word]

#print axioms mem_H_iff_word
#print axioms card_H

end TwoCopy
