/-
Two-copy identity, file 3 of 6: the images of S under H, and the pointwise identity (target (a)).

What this file proves, in plain words.

  * `mem_Sset`: the k-th named image of S (under the identity, τ₀, τ₁, τ₃) is the set of points
    where M ∘ (that relabeling) = −4.
  * `image_mem_H`: the image of S under ANY element of H (the group generated by the four τ_j)
    is one of the four named sets. `Sset_is_image`: each named set is the image of S under an
    element of H. `Sset_injective`: the four named sets are pairwise distinct.
    `images_eq`, `card_images`: so the set of images of S under H is exactly these four sets.
  * `pointwise`: at every point of Ω, 1_{S₀} + 1_{S₁} + 1_{S₂} + 1_{S₃} = 2 − C₁C₂/4.
  * Controls, proved as negations: `pointwise_const_unique` (with 2 replaced by any other
    constant the identity is false), `single_set_false` (4·1_S = 2 − C₁C₂/4 is false).
  * `indF_Sset`: 1_{S_k} = 1/2 − (M ∘ rep k)/8, the form the proof of Theorem 1 uses.

That H has order 64 (the draft's parenthesis) is proved in `GroupOrder.lean`; nothing here or
in the files that follow uses it.
-/
import TwoCopy.Finite

namespace TwoCopy

open Finset

theorem mem_S (ω : Pt) : ω ∈ S ↔ M ω = -4 := by simp [S]

/-- The k-th named image of S is [M ∘ rep k = −4] (rep k is an involution). -/
theorem mem_Sset (k : Fin 4) (ω : Pt) : ω ∈ Sset k ↔ M (rep k ω) = -4 := by
  unfold Sset
  rw [Finset.mem_image]
  constructor
  · rintro ⟨ω', h, rfl⟩
    rw [rep_invol]; exact (mem_S _).1 h
  · intro h
    exact ⟨rep k ω, (mem_S _).2 h, rep_invol k ω⟩

theorem Sset_zero : Sset 0 = S := by
  ext ω; rw [mem_Sset, mem_S]; rfl

/-- The four named images are pairwise distinct. -/
theorem Sset_injective : Function.Injective Sset := by
  intro k k' h
  by_contra hne
  obtain ⟨ω, h1, h2⟩ := distinct k k' hne
  exact h2 ((mem_Sset k' ω).1 (h ▸ (mem_Sset k ω).2 h1))

theorem tauPerm_inv (j : Fin 4) : (tauPerm j)⁻¹ = tauPerm j := rfl

/-- Each generator maps each named set onto a named set. -/
theorem image_tau (j k : Fin 4) : ∃ k', (Sset k).image (tauPerm j) = Sset k' := by
  obtain ⟨k', hk'⟩ := stab j k
  refine ⟨k', ?_⟩
  ext ω
  rw [mem_Sset, Finset.mem_image]
  constructor
  · rintro ⟨ω', h, rfl⟩
    rw [← hk']
    show M (rep k (tau j (tau j ω'))) = -4
    rw [tau_invol]; exact (mem_Sset k ω').1 h
  · intro h
    exact ⟨tau j ω, (mem_Sset k _).2 ((hk' ω).2 h), tau_invol j ω⟩

/-- Every element of H, and its inverse, maps each named set onto a named set. -/
theorem image_Sset_mem_H {g : Equiv.Perm Pt} (hg : g ∈ H) :
    (∀ k, ∃ k', (Sset k).image g = Sset k') ∧
      (∀ k, ∃ k', (Sset k).image (g⁻¹ : Equiv.Perm Pt) = Sset k') := by
  unfold H at hg
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    exact ⟨image_tau j, by rw [tauPerm_inv]; exact image_tau j⟩
  | one =>
    exact ⟨fun k => ⟨k, by ext ω; simp⟩, fun k => ⟨k, by ext ω; simp⟩⟩
  | mul x y hx hy ihx ihy =>
    constructor
    · intro k
      obtain ⟨k1, h1⟩ := ihy.1 k
      obtain ⟨k2, h2⟩ := ihx.1 k1
      refine ⟨k2, ?_⟩
      rw [← h2, ← h1, Finset.image_image]; rfl
    · intro k
      rw [mul_inv_rev]
      obtain ⟨k1, h1⟩ := ihx.2 k
      obtain ⟨k2, h2⟩ := ihy.2 k1
      refine ⟨k2, ?_⟩
      rw [← h2, ← h1, Finset.image_image]; rfl
  | inv x hx ih => exact ⟨ih.2, by rw [inv_inv]; exact ih.1⟩

/-- The image of S under any element of H is one of the four named sets. -/
theorem image_mem_H {g : Equiv.Perm Pt} (hg : g ∈ H) : ∃ k, S.image g = Sset k := by
  obtain ⟨k, hk⟩ := (image_Sset_mem_H hg).1 0
  exact ⟨k, by rw [← hk, Sset_zero]⟩

/-- Each named set is the image of S under an element of H: 1, τ₀, τ₁, τ₃. -/
theorem Sset_is_image (k : Fin 4) : ∃ g ∈ H, S.image g = Sset k := by
  fin_cases k
  · exact ⟨1, one_mem _, by ext ω; simp [Sset_zero]⟩
  · exact ⟨tauPerm 0, Subgroup.subset_closure ⟨0, rfl⟩, rfl⟩
  · exact ⟨tauPerm 1, Subgroup.subset_closure ⟨1, rfl⟩, rfl⟩
  · exact ⟨tauPerm 3, Subgroup.subset_closure ⟨3, rfl⟩, rfl⟩

/-- The images of S under H are exactly the four named sets. -/
theorem images_eq : {T : Finset Pt | ∃ g ∈ H, S.image g = T} = Set.range Sset := by
  ext T
  constructor
  · rintro ⟨g, hg, rfl⟩
    obtain ⟨k, hk⟩ := image_mem_H hg
    exact ⟨k, hk.symm⟩
  · rintro ⟨k, rfl⟩
    exact Sset_is_image k

/-- There are exactly four of them. -/
theorem card_images : (univ.image Sset).card = 4 := by
  rw [Finset.card_image_of_injective _ Sset_injective]; rfl

/-- Each image has 128 points. -/
theorem card_Sset (k : Fin 4) : (Sset k).card = 128 := by
  unfold Sset
  rw [Finset.card_image_of_injective _ (Function.LeftInverse.injective (rep_invol k)), card_S]

/-- 1_{S_k} = 1/2 − (M ∘ rep k)/8. -/
theorem indF_Sset (k : Fin 4) (ω : Pt) : indF (Sset k) ω = 1 / 2 - (M (rep k ω) : ℝ) / 8 := by
  simp only [indF, mem_Sset]
  rcases M_pm (rep k ω) with h | h <;> rw [h] <;> norm_num

/-- The pointwise identity: 1_{S₀} + 1_{S₁} + 1_{S₂} + 1_{S₃} = 2 − C₁C₂/4 at every point. -/
theorem pointwise (ω : Pt) : ∑ k, indF (Sset k) ω = 2 - (C 0 ω : ℝ) * (C 1 ω : ℝ) / 4 := by
  have h := pointwiseZ ω
  have h' : (4 : ℝ) * ∑ k, indF (Sset k) ω = 8 - (C 0 ω : ℝ) * (C 1 ω : ℝ) := by
    have : ∑ k, indF (Sset k) ω = ((∑ k, (if M (rep k ω) = -4 then (1 : ℤ) else 0) : ℤ) : ℝ) := by
      push_cast
      refine Finset.sum_congr rfl fun k _ => ?_
      simp only [indF, mem_Sset]
    rw [this]; exact_mod_cast h
  linarith

/-- Control: with 2 replaced by any other constant the pointwise identity is false. -/
theorem pointwise_const_unique (c : ℝ) (hc : c ≠ 2) :
    ¬ ∀ ω, ∑ k, indF (Sset k) ω = c - (C 0 ω : ℝ) * (C 1 ω : ℝ) / 4 := by
  intro h
  have h1 := h 0
  rw [pointwise] at h1
  apply hc; linarith

/-- Control: the single-set analogue 4·1_S = 2 − C₁C₂/4 is false (at the all-zero point the
left side is 0 and the right side is 1). -/
theorem single_set_false : ¬ ∀ ω, 4 * indF S ω = 2 - (C 0 ω : ℝ) * (C 1 ω : ℝ) / 4 := by
  intro h
  have h0 := h 0
  obtain ⟨_, hM, hC0, hC1⟩ := values_at_zero
  have hS : (0 : Pt) ∉ S := by rw [mem_S, hM]; norm_num
  simp only [indF, if_neg hS, hC0, hC1] at h0
  norm_num at h0

end TwoCopy
